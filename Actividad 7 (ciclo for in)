notas = [8.5, 6.0, 9.0, 7.0, 5.5]
suma = 0
cantidad = 0
aprobados = 0
reprobados = 0
for nota in notas:
    suma = suma + nota
    cantidad = cantidad + 1
    if nota >= 7:
        aprobados = aprobados + 1
    else:
        reprobados = reprobados + 1
promedio = suma / cantidad
print(f"Suma total: {suma}")
print(f"Promedio: {promedio}")
print(f"Aprobados: {aprobados}")
print(f"Reprobados: {reprobados}")

